# `npm test` relies on `node --test` glob expansion (see package.json), which
# requires Node >=21 — declared as a `devEngines.runtime` constraint so `npm
# install` in this repo fails loudly on older Node instead of silently
# collecting zero tests. `engine-strict` also enforces the published `engines`
# floor (>=20), the actual runtime requirement of the shipped dist.
engine-strict=true
