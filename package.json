{
  "name": "@copse/streaming-markdown",
  "version": "0.6.0",
  "description": "Streaming-capable CommonMark markdown renderer (string HTML + incremental DOM emitters)",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copse-dev/streaming-markdown.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sanitizers/dompurify": {
      "types": "./dist/sanitize-dompurify.d.ts",
      "import": "./dist/sanitize-dompurify.js",
      "default": "./dist/sanitize-dompurify.js"
    },
    "./highlighters/highlightjs": {
      "types": "./dist/highlight-hljs.d.ts",
      "import": "./dist/highlight-hljs.js",
      "default": "./dist/highlight-hljs.js"
    },
    "./highlighters/shiki": {
      "types": "./dist/highlight-shiki.d.ts",
      "import": "./dist/highlight-shiki.js",
      "default": "./dist/highlight-shiki.js"
    },
    "./diagrams/mermaid": {
      "types": "./dist/mermaid-mermaidjs.d.ts",
      "import": "./dist/mermaid-mermaidjs.js",
      "default": "./dist/mermaid-mermaidjs.js"
    },
    "./math/katex": {
      "types": "./dist/math-katex.d.ts",
      "import": "./dist/math-katex.js",
      "default": "./dist/math-katex.js"
    },
    "./inline/emoji": {
      "types": "./dist/emoji-shortcodes.d.ts",
      "import": "./dist/emoji-shortcodes.js",
      "default": "./dist/emoji-shortcodes.js"
    },
    "./sanitizers/browser": {
      "types": "./dist/sanitize-browser.d.ts",
      "import": "./dist/sanitize-browser.js",
      "default": "./dist/sanitize-browser.js"
    },
    "./styles/core.css": "./styles/core.css",
    "./styles/default.css": "./styles/default.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=21",
      "onFail": "error"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:demo": "npm run build && rm -f docs/streaming-markdown.*.mjs && esbuild docs/browser-entry.mjs --bundle --splitting --format=esm --platform=browser --outdir=docs --out-extension:.js=.mjs --entry-names=streaming-markdown.browser --chunk-names=streaming-markdown.[name]-[hash]",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test tests/trusted-types.e2e.test.ts",
    "coverage": "c8 npm test",
    "coverage:check": "node --import tsx scripts/coverage-gate.mts",
    "coverage:update": "node --import tsx scripts/coverage-gate.mts --update",
    "coverage:ci": "npm run coverage && npm run coverage:check",
    "check:conformance": "node --import tsx --test src/commonmark-conformance.test.ts",
    "check:gfm-conformance": "node --import tsx --test src/gfm-conformance.test.ts",
    "check:gfm-spec": "tsx scripts/fetch-gfm-spec.mts",
    "check:normalizer-parity": "tsx scripts/fetch-reference-normalizer.mts && tsx scripts/check-normalizer-parity.mts",
    "bench": "tsx scripts/bench-streaming.mts",
    "bench:browser": "tsx scripts/bench-browser.mts",
    "changelog": "tsx scripts/gen-changelog.mts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "entities": "^8.0.0"
  },
  "peerDependencies": {
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.0 || ^0.17.0",
    "mermaid": "^11.0.0",
    "shiki": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "c8": "^11.0.0",
    "commonmark-spec": "0.31.2",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "playwright-core": "^1.61.1",
    "shiki": "^4.3.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
